<Project Sdk="Microsoft.NET.Sdk">

  <!-- Chariot: rendezvous and mailbox for Pegasus. Not a peer - it never holds
       a note, never merges an update, and cannot read a word either party
       writes. docs/Chariot_Design.md is the record; §4 is why "relay" and
       "peer" are different things here.

       NO WEB STACK, and that is the whole point of speaking the Pegasus frame
       protocol. No ASP.NET Core, no SignalR, no Entity Framework, no OpenAPI.
       The forked C# server had all four and this has a TCP listener. §3
       records what that decision bought and what it deferred. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>EmuSen.Chariot</AssemblyName>
    <RootNamespace>EmuSen.Chariot</RootNamespace>

    <!-- 0.1.0, the first released relay, on a `v*` tag. Not the same number as
         the EmuSen.Pegasus.Core package it speaks through, which is at 0.3.0 —
         that one versions on the protocol, this one on the server. Pegasus the
         desktop application is 0.1.0 as well, and that is a coincidence of both
         being released for the first time on the same day rather than a rule
         that they move together. What has to agree between the two programs is
         the protocol number in Hello, not the version on the download. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Db.fs" />
    <Compile Include="Accounts.fs" />
    <Compile Include="ServerIdentity.fs" />
    <Compile Include="Mailbox.fs" />
    <Compile Include="Presence.fs" />
    <Compile Include="Server.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The wire types, the codec, the sealed envelope, the framing and the
         identity primitives, shared with the desktop application so there is
         one implementation of the protocol rather than two kept in step by
         hand. Its own only dependency is FSharp.Core.

         0.2.2 rather than 0.2.0, and the difference is not the protocol — it is
         the same wire, frame for frame. 0.2.0 and 0.2.1 left FSharp.Core
         implicit, so each declared whatever floor the machine that packed it
         happened to ship, and restoring either here produced an NU1605
         downgrade against a package this project had just been told to trust.
         That warning, raised from this file, is how the defect was found; both
         versions are unlisted on nuget.org now. Pegasus_Design.md §7.1 in the
         EmuSen.Pegasus repository carries the full account.

         0.3.0 is not the protocol either — still the same wire, frame for
         frame, and Hello still says 4. It is the relicence: 0.2.x is
         GPL-3.0-or-later and 0.3.0 is MIT. This bump is load-bearing rather
         than housekeeping, because §11 relicenses THIS repository to MIT and a
         program cannot honestly claim MIT while linking a GPL library. The
         version below is what makes the LICENSE file beside it true. -->
    <PackageReference Include="EmuSen.Pegasus.Core" Version="0.3.0" />
    <!-- Microsoft.Data.Sqlite alone resolves SQLitePCLRaw 2.1.11, which carries
         a high-severity advisory (GHSA-2m69-gcr7-jv3q) - the very advisory §2.2
         cites against the stack this replaces. The 3.0.5 bundle pin overrides
         it. Keep the pair together. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
