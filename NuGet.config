<?xml version="1.0" encoding="utf-8"?>
<!-- EmuSen.Pegasus.Core comes from nuget.org. It is built from the
     EmuSen.Pegasus repository and consumed here as a package because a
     ProjectReference cannot cross a repository boundary, and it is published
     from a `core-v*` tag there by a workflow holding no credential - NuGet
     Trusted Publishing exchanges a GitHub OIDC token for a key good for
     minutes.

     This file used to also name a `local-packages/` folder feed, populated by
     `dotnet pack` in that checkout. That is gone, and so is the trap it
     carried - but the trap is worth remembering, because it applies again the
     moment somebody sets a folder feed up to iterate on the core without
     publishing it: NuGet caches by package id AND version in ~/.nuget/packages,
     so a rebuilt 0.2.0 is ignored in favour of the copy already extracted
     there, and the build fails on code that was just written as though it did
     not exist. Either use a version that changes every pack, or
     `rm -rf ~/.nuget/packages/emusen.pegasus.core` first.

     Kept as an explicit <clear /> plus nuget.org rather than deleted, so a
     stray source in a machine-wide NuGet.config cannot quietly change where a
     dependency of this project comes from. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
