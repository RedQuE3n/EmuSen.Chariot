<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- EmuSen.Pegasus.Core is built from the EmuSen.Pegasus repository and
         consumed here as a package, because a ProjectReference cannot cross a
         repository boundary. Repopulate with:
             dotnet pack src/EmuSen.Pegasus.Core -c Release -o <this>/local-packages
         GitHub Packages is the intended destination; this folder is what stands
         in until the package is pushed there. Same arrangement, and the same
         temporariness, as EmuSen.LunaP has in the Pegasus repository. -->
    <add key="local" value="local-packages" />
  </packageSources>
</configuration>
