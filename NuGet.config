<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- EmuSen.Pegasus.Core is built from the EmuSen.Pegasus repository and
         consumed here as a package, because a ProjectReference cannot cross a
         repository boundary. Repopulate with:
             dotnet pack src/EmuSen.Pegasus.Core -c Release -o <this>/local-packages
         GitHub Packages is the intended destination; this folder is what stands
         in until the package is pushed there. Same arrangement, and the same
         temporariness, as EmuSen.LunaP has in the Pegasus repository.

         TRAP, and it will cost somebody an afternoon: repacking the SAME version
         does not propagate. NuGet caches by id and version in
         ~/.nuget/packages, so a rebuilt 0.1.0 is ignored in favour of the copy
         already extracted there, and the build fails on code you just wrote as
         if it did not exist. Clear it after packing:
             rm -rf ~/.nuget/packages/emusen.pegasus.core
         Bumping the version each time would also work and is the right answer
         once this package is published rather than hand-carried. -->
    <add key="local" value="local-packages" />
  </packageSources>
</configuration>
